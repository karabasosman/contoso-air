# syntax=docker/dockerfile:1

FROM node:22-alpine

# Add metadata labels
LABEL maintainer="contoso-air" \
      description="Contoso Air - Sample airline booking application" \
      version="1.0" \
      org.opencontainers.image.title="Contoso Air Web Application" \
      org.opencontainers.image.description="A sample airline booking application for demos and learning" \
      org.opencontainers.image.vendor="Contoso Air" \
      org.opencontainers.image.licenses="MIT"

# Create app directory
WORKDIR /usr/src/app

# Copy package files for dependency installation (cache layer optimization)
COPY package*.json ./

# Install production dependencies with performance optimizations
RUN npm ci --omit=dev --no-audit --no-fund --prefer-offline && \
    npm cache clean --force

# Copy application source code
COPY . .

# Set production environment
ENV NODE_ENV=production \
    PORT=3000

# Expose the application port
EXPOSE 3000

# Create a non-root user with specific UID/GID for security
RUN addgroup -g 1001 -S appgroup && \
    adduser -u 1001 -S appuser -G appgroup && \
    chown -R appuser:appgroup /usr/src/app

# Add health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD node -e "const http = require('http'); \
        const options = { host: '0.0.0.0', port: 3000, path: '/', timeout: 2000 }; \
        const req = http.request(options, (res) => { \
            if (res.statusCode === 200) process.exit(0); \
            else process.exit(1); \
        }); \
        req.on('error', () => process.exit(1)); \
        req.on('timeout', () => process.exit(1)); \
        req.end();"

# Switch to non-root user
USER appuser

# Start the application
CMD ["node", "./bin/www"]
